# Rendered video: large and regenerable. Rebuild with
#   python3 tools/build_lecture.py assemble <week>.json
# in about 5 minutes, without re-voicing anything.
media/**/*.mp4

# Heavy derived intermediates — regenerable.
media/**/work*/
media/**/slides/
media/**/_pptx_tmp.png
__pycache__/
*.pyc

# Toolchain binaries and fonts: rebuild with tools/setup_env.sh
assets/fonts/
tools/bin/

# Local overrides
.env
